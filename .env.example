NODE_ENV=production
PORT=6010

DATABASE=mongodb+srv://USER:PASSWORD@cluster.example.net/planary
DATABASE_PASSWORD=

JWT_SECRET=
JWT_EXPIRES_IN=90d

EMAIL_HOST=
EMAIL_PORT=587
EMAIL_ADDRESS=
EMAIL_FROM=
EMAIL_PASSWORD=
EMAIL_TO=

COMPANY_NAME=Planary

VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Overridden to redis://redis:6379 by docker-compose.vps.yml in production
REDIS_URL=redis://127.0.0.1:6379

# Optional: manual VPS deploy only (PAT with read:packages). CI logs in automatically.
# GHCR_PULL_TOKEN=
# GHCR_USERNAME=somadina94

# Optional override (default matches GHCR package from GitHub Actions)
# PLANARY_SERVER_IMAGE=ghcr.io/somadina94/expenses-tracker-server:latest
